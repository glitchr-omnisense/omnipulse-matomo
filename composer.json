{
    "name": "omnipulse/matomo",
    "type": "library",
    "description": "Omnipulse's Matomo, under any PHP host: visits, visitors, pageviews, bounce rate and visit length of a site, by entry page, page, referrer, country, device or day, through Matomo's Reporting API (self-hosted or Matomo Cloud), the token sent by POST.",
    "keywords": [
        "matomo",
        "analytics",
        "audience",
        "reporting-api",
        "entry-pages",
        "framework-agnostic",
        "omnipulse"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnipulse-matomo",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnipulse": "^1.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "replace": {
        "omnireach/matomo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Omnipulse\\Matomo\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipulse\\Matomo\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
